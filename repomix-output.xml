<file path="supabase/schema.sql">
-- =====================================================================
-- TABLAS
-- =====================================================================
create table public.profiles (
  id uuid primary key references auth.users (id) on delete cascade,
  role text not null default 'empleado'
    check (role in ('admin', 'cocinero', 'mesero', 'empleado')),
  full_name text,
  created_at timestamptz not null default now()
);

create table public.wellness_resources (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  content text not null,
  category text not null default 'general',
  created_at timestamptz not null default now()
);

create table public.hr_queries (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null default auth.uid() references public.profiles (id) on delete cascade,
  subject text not null check (char_length(subject) between 1 and 200),
  status text not null default 'open' check (status in ('open', 'answered', 'closed')),
  created_at timestamptz not null default now()
);

create table public.hr_messages (
  id uuid primary key default gen_random_uuid(),
  query_id uuid not null references public.hr_queries (id) on delete cascade,
  sender_id uuid not null default auth.uid() references public.profiles (id) on delete cascade,
  message text not null check (char_length(message) between 1 and 2000),
  created_at timestamptz not null default now()
);

create table public.menu_items (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  description text,
  recipe jsonb,
  allergens text[] not null default '{}'
);

create index hr_queries_user_id_idx on public.hr_queries (user_id);
create index hr_messages_query_id_idx on public.hr_messages (query_id);

-- =====================================================================
-- TRIGGER: alta de perfil al crear usuario en auth.users
-- =====================================================================
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_role text;
begin
  v_role := coalesce(new.raw_user_meta_data ->> 'role', 'empleado');

  -- SEGURIDAD: 'admin' jamás se asigna desde raw_user_meta_data; se promueve solo por SQL con privilegios.
  if v_role not in ('cocinero', 'mesero', 'empleado') then
    v_role := 'empleado';
  end if;

  insert into public.profiles (id, role, full_name)
  values (new.id, v_role, coalesce(new.raw_user_meta_data ->> 'full_name', ''));

  return new;
end;
$$;

create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- =====================================================================
-- FUNCIÓN AUXILIAR: rol del usuario autenticado (evita recursión de RLS)
-- =====================================================================
create or replace function public.get_my_role()
returns text
language sql
stable
security definer
set search_path = public
as $$
  select p.role from public.profiles p where p.id = auth.uid();
$$;

revoke all on function public.get_my_role() from public, anon;
grant execute on function public.get_my_role() to authenticated;

-- =====================================================================
-- RLS
-- =====================================================================
alter table public.profiles enable row level security;
alter table public.wellness_resources enable row level security;
alter table public.hr_queries enable row level security;
alter table public.hr_messages enable row level security;
alter table public.menu_items enable row level security;

revoke all on public.profiles, public.wellness_resources, public.hr_queries,
  public.hr_messages, public.menu_items from anon;

-- profiles: cada usuario lee solo su propio perfil; admin gestiona todos. Ningún usuario puede cambiar su rol.
create policy profiles_select_own on public.profiles
  for select to authenticated
  using (id = (select auth.uid()));

create policy profiles_admin_all on public.profiles
  for all to authenticated
  using ((select public.get_my_role()) = 'admin')
  with check ((select public.get_my_role()) = 'admin');

-- wellness_resources: cualquier usuario autenticado lee; solo admin crea, edita y elimina.
create policy wellness_select_authenticated on public.wellness_resources
  for select to authenticated
  using (true);

create policy wellness_admin_all on public.wellness_resources
  for all to authenticated
  using ((select public.get_my_role()) = 'admin')
  with check ((select public.get_my_role()) = 'admin');

-- hr_queries: el usuario solo ve y crea sus propias consultas; admin ve y gestiona todas; cocinero NO tiene acceso.
create policy hr_queries_select_own on public.hr_queries
  for select to authenticated
  using (
    user_id = (select auth.uid())
    and (select public.get_my_role()) in ('admin', 'mesero', 'empleado')
  );

create policy hr_queries_insert_own on public.hr_queries
  for insert to authenticated
  with check (
    user_id = (select auth.uid())
    and (select public.get_my_role()) in ('admin', 'mesero', 'empleado')
  );

create policy hr_queries_admin_all on public.hr_queries
  for all to authenticated
  using ((select public.get_my_role()) = 'admin')
  with check ((select public.get_my_role()) = 'admin');

-- hr_messages: el usuario solo lee y escribe en sus propias consultas; admin lee y responde en todas; cocinero NO tiene acceso.
create policy hr_messages_select_own on public.hr_messages
  for select to authenticated
  using (
    (select public.get_my_role()) in ('admin', 'mesero', 'empleado')
    and exists (
      select 1 from public.hr_queries q
      where q.id = hr_messages.query_id
        and q.user_id = (select auth.uid())
    )
  );

create policy hr_messages_insert_own on public.hr_messages
  for insert to authenticated
  with check (
    sender_id = (select auth.uid())
    and (select public.get_my_role()) in ('admin', 'mesero', 'empleado')
    and exists (
      select 1 from public.hr_queries q
      where q.id = hr_messages.query_id
        and q.user_id = (select auth.uid())
    )
  );

create policy hr_messages_admin_select on public.hr_messages
  for select to authenticated
  using ((select public.get_my_role()) = 'admin');

create policy hr_messages_admin_insert on public.hr_messages
  for insert to authenticated
  with check (
    (select public.get_my_role()) = 'admin'
    and sender_id = (select auth.uid())
  );

-- menu_items: la tabla base (con recipe) solo la leen cocinero y admin; solo admin escribe.
-- El mesero y demás roles consultan la carta por la vista menu_items_public (sin recipe) o por la RPC get_menu_item_for_role.
create policy menu_items_select_cocinero on public.menu_items
  for select to authenticated
  using ((select public.get_my_role()) = 'cocinero');

create policy menu_items_admin_all on public.menu_items
  for all to authenticated
  using ((select public.get_my_role()) = 'admin')
  with check ((select public.get_my_role()) = 'admin');

-- Vista sin la columna recipe; se ejecuta con los privilegios del dueño (omite RLS de la tabla base de forma intencional).
create view public.menu_items_public as
  select id, name, description, allergens
  from public.menu_items;

revoke all on public.menu_items_public from public, anon, authenticated;
grant select on public.menu_items_public to authenticated;

-- =====================================================================
-- RPC: plato según el rol del usuario (recipe solo para cocinero y admin)
-- =====================================================================
create or replace function public.get_menu_item_for_role(item_id uuid)
returns jsonb
language plpgsql
stable
security definer
set search_path = public
as $$
declare
  v_role text;
  v_item jsonb;
begin
  if auth.uid() is null then
    raise exception 'No autenticado' using errcode = '28000';
  end if;

  select p.role into v_role from public.profiles p where p.id = auth.uid();

  if v_role is null then
    raise exception 'Perfil no encontrado' using errcode = '42501';
  end if;

  select case
           when v_role in ('cocinero', 'admin') then to_jsonb(m)
           else to_jsonb(m) - 'recipe'
         end
    into v_item
    from public.menu_items m
   where m.id = item_id;

  return v_item;
end;
$$;

revoke all on function public.get_menu_item_for_role(uuid) from public, anon;
grant execute on function public.get_menu_item_for_role(uuid) to authenticated;
</file>

