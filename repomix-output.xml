<file path="src/modules/wellness/WellnessDashboard.tsx">
import { useEffect, useMemo, useState } from 'react';
import DOMPurify from 'dompurify';
import { supabase, type WellnessResource } from '../../lib/supabaseClient';

const SANITIZE_CONFIG = {
  ALLOWED_TAGS: ['p', 'br', 'b', 'i', 'em', 'strong', 'ul', 'ol', 'li', 'h3', 'h4', 'blockquote'],
  ALLOWED_ATTR: [] as string[],
};

const formatDate = (iso: string): string =>
  new Date(iso).toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' });

export default function WellnessDashboard() {
  const [resources, setResources] = useState<WellnessResource[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let active = true;

    const load = async (): Promise<void> => {
      const { data, error: fetchError } = await supabase
        .from('wellness_resources')
        .select('*')
        .order('created_at', { ascending: false });

      if (!active) return;

      if (fetchError) {
        console.error('Error cargando recursos de bienestar:', fetchError.message);
        setError('No se pudieron cargar los recursos de bienestar.');
      } else {
        setResources(data ?? []);
      }
      setLoading(false);
    };

    void load();

    return () => {
      active = false;
    };
  }, []);

  const safeResources = useMemo(
    () =>
      resources.map((resource) => ({
        ...resource,
        safeContent: DOMPurify.sanitize(resource.content, SANITIZE_CONFIG),
      })),
    [resources],
  );

  return (
    <section>
      <h1>Bienestar</h1>

      {loading && <p className="muted">Cargando recursos…</p>}
      {error && (
        <p className="alert" role="alert">
          {error}
        </p>
      )}
      {!loading && !error && safeResources.length === 0 && (
        <p className="muted">Aún no hay recursos publicados.</p>
      )}

      <div className="card-grid">
        {safeResources.map((resource) => (
          <article key={resource.id} className="card">
            <span className="badge">{resource.category}</span>
            <h2>{resource.title}</h2>
            <div className="rich" dangerouslySetInnerHTML={{ __html: resource.safeContent }} />
            <small className="muted">{formatDate(resource.created_at)}</small>
          </article>
        ))}
      </div>
    </section>
  );
}
</file>

<file path="src/App.tsx">
import { useState, type FormEvent, type ReactNode } from 'react';
import { Link, Navigate, NavLink, Route, Routes, useLocation } from 'react-router-dom';
import { useAuth } from './auth/useAuth';
import ProtectedRoute from './components/layout/ProtectedRoute';
import { supabase, type AppRole } from './lib/supabaseClient';
import HRChat from './modules/hr-chat/HRChat';
import MenuAgent from './modules/menu-agent/MenuAgent';
import WellnessDashboard from './modules/wellness/WellnessDashboard';

const ALL_ROLES: AppRole[] = ['admin', 'cocinero', 'mesero', 'empleado'];
const HR_ROLES: AppRole[] = ['admin', 'mesero', 'empleado'];

const NAV_ITEMS: { to: string; label: string; roles: AppRole[] }[] = [
  { to: '/bienestar', label: 'Bienestar', roles: ALL_ROLES },
  { to: '/rrhh', label: 'Chat RR. HH.', roles: HR_ROLES },
  { to: '/carta', label: 'Agente de carta', roles: ALL_ROLES },
];

function AppShell({ children }: { children: ReactNode }) {
  const { profile, role, signOut } = useAuth();
  const links = NAV_ITEMS.filter((item) => role !== null && item.roles.includes(role));

  return (
    <div className="app-shell">
      <header className="topbar">
        <strong>Página Servicio</strong>
        <nav aria-label="Principal">
          {links.map((link) => (
            <NavLink
              key={link.to}
              to={link.to}
              className={({ isActive }) => (isActive ? 'active' : undefined)}
            >
              {link.label}
            </NavLink>
          ))}
        </nav>
        <div className="topbar-user">
          <span className="muted">
            {profile?.full_name || 'Usuario'} · {role}
          </span>
          <button
            type="button"
            className="btn btn-secondary"
            onClick={() => {
              void signOut();
            }}
          >
            Salir
          </button>
        </div>
      </header>
      <main className="container">{children}</main>
    </div>
  );
}

function Guarded({ roles, children }: { roles: AppRole[]; children: ReactNode }) {
  return (
    <ProtectedRoute allowedRoles={roles}>
      <AppShell>{children}</AppShell>
    </ProtectedRoute>
  );
}

function LoginPage() {
  const { user } = useAuth();
  const location = useLocation();
  const [email, setEmail] = useState<string>('');
  const [password, setPassword] = useState<string>('');
  const [error, setError] = useState<string | null>(null);
  const [submitting, setSubmitting] = useState<boolean>(false);

  if (user) {
    const from =
      (location.state as { from?: { pathname?: string } } | null)?.from?.pathname ?? '/';
    return <Navigate to={from} replace />;
  }

  const handleSubmit = async (event: FormEvent<HTMLFormElement>): Promise<void> => {
    event.preventDefault();
    if (submitting) return;

    setSubmitting(true);
    setError(null);

    const { error: signInError } = await supabase.auth.signInWithPassword({
      email: email.trim(),
      password,
    });

    setSubmitting(false);
    if (signInError) {
      setError('Credenciales inválidas.');
    }
  };

  return (
    <main className="page-center">
      <form onSubmit={(event) => void handleSubmit(event)} className="card stack login-card">
        <h1>Iniciar sesión</h1>

        <label htmlFor="login-email">Correo electrónico</label>
        <input
          id="login-email"
          type="email"
          autoComplete="email"
          value={email}
          onChange={(event) => setEmail(event.target.value)}
          required
        />

        <label htmlFor="login-password">Contraseña</label>
        <input
          id="login-password"
          type="password"
          autoComplete="current-password"
          value={password}
          onChange={(event) => setPassword(event.target.value)}
          required
        />

        {error && (
          <p className="alert" role="alert">
            {error}
          </p>
        )}

        <button type="submit" className="btn" disabled={submitting}>
          {submitting ? 'Ingresando…' : 'Ingresar'}
        </button>
      </form>
    </main>
  );
}

function ForbiddenPage() {
  return (
    <main className="page-center">
      <div className="card stack login-card">
        <h1>403</h1>
        <p>No tienes permiso para acceder a esta sección.</p>
        <Link to="/" className="btn">
          Volver al inicio
        </Link>
      </div>
    </main>
  );
}

export default function App() {
  return (
    <Routes>
      <Route path="/login" element={<LoginPage />} />
      <Route path="/403" element={<ForbiddenPage />} />
      <Route path="/" element={<Navigate to="/bienestar" replace />} />
      <Route
        path="/bienestar"
        element={
          <Guarded roles={ALL_ROLES}>
            <WellnessDashboard />
          </Guarded>
        }
      />
      <Route
        path="/rrhh"
        element={
          <Guarded roles={HR_ROLES}>
            <HRChat />
          </Guarded>
        }
      />
      <Route
        path="/carta"
        element={
          <Guarded roles={ALL_ROLES}>
            <MenuAgent />
          </Guarded>
        }
      />
      <Route path="*" element={<Navigate to="/" replace />} />
    </Routes>
  );
}
</file>

