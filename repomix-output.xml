<file path="src/lib/supabaseClient.ts">
import { createClient } from '@supabase/supabase-js';

export type Json =
  | string
  | number
  | boolean
  | null
  | { [key: string]: Json | undefined }
  | Json[];

export type AppRole = 'admin' | 'cocinero' | 'mesero' | 'empleado';
export type HRQueryStatus = 'open' | 'answered' | 'closed';

export type Profile = {
  id: string;
  role: AppRole;
  full_name: string | null;
  created_at: string;
};

export type WellnessResource = {
  id: string;
  title: string;
  content: string;
  category: string;
  created_at: string;
};

export type HRQuery = {
  id: string;
  user_id: string;
  subject: string;
  status: HRQueryStatus;
  created_at: string;
};

export type HRMessage = {
  id: string;
  query_id: string;
  sender_id: string;
  message: string;
  created_at: string;
};

export type MenuItemRow = {
  id: string;
  name: string;
  description: string | null;
  recipe: Json | null;
  allergens: string[];
};

export type MenuItemPublic = {
  id: string;
  name: string;
  description: string | null;
  allergens: string[];
};

export type MenuItemResult = MenuItemPublic & { recipe?: Json | null };

type Table<Row, Insert> = {
  Row: Row;
  Insert: Insert;
  Update: Partial<Insert>;
  Relationships: [];
};

export type Database = {
  public: {
    Tables: {
      profiles: Table<
        Profile,
        { id: string; role?: AppRole; full_name?: string | null; created_at?: string }
      >;
      wellness_resources: Table<
        WellnessResource,
        { id?: string; title: string; content: string; category?: string; created_at?: string }
      >;
      hr_queries: Table<
        HRQuery,
        { id?: string; user_id?: string; subject: string; status?: HRQueryStatus; created_at?: string }
      >;
      hr_messages: Table<
        HRMessage,
        { id?: string; query_id: string; sender_id?: string; message: string; created_at?: string }
      >;
      menu_items: Table<
        MenuItemRow,
        { id?: string; name: string; description?: string | null; recipe?: Json | null; allergens?: string[] }
      >;
    };
    Views: {
      menu_items_public: { Row: MenuItemPublic; Relationships: [] };
    };
    Functions: {
      get_menu_item_for_role: { Args: { item_id: string }; Returns: Json };
    };
    Enums: Record<string, never>;
    CompositeTypes: Record<string, never>;
  };
};

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;

if (!supabaseUrl || !supabaseAnonKey) {
  throw new Error('Faltan VITE_SUPABASE_URL o VITE_SUPABASE_ANON_KEY en las variables de entorno.');
}

export const supabase = createClient<Database>(supabaseUrl, supabaseAnonKey, {
  auth: {
    persistSession: true,
    autoRefreshToken: true,
    detectSessionInUrl: true,
  },
});
</file>

